{
  "$schema": "../../../../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "maps-in-parameters-constant-key-test",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0000000000000000000000000000000000000001"
        },
        {
          "chainId": 8453,
          "address": "0x0000000000000000000000000000000000000002"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Test Owner",
    "maps": {
      "addresses": {
        "$keyType": "chainId",
        "values": {
          "1": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
          "8453": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
        }
      },
      "selectors": {
        "$keyType": "chainId",
        "values": {
          "1": "0xa9059cbb",
          "8453": "0x095ea7b3"
        }
      },
      "amounts": {
        "$keyType": "chainId",
        "values": {
          "1": 1000,
          "8453": 2000
        }
      },
      "targetChains": {
        "$keyType": "chainId",
        "values": {
          "1": 10,
          "8453": 42161
        }
      }
    },
    "constants": {
      "chain": "8453"
    }
  },
  "display": {
    "formats": {
      "execute(address target, bytes data)": {
        "intent": "Execute",
        "fields": [
          {
            "path": "data",
            "label": "Embedded call",
            "format": "calldata",
            "params": {
              "callee": {
                "map": "$.metadata.maps.addresses",
                "keyPath": "$.metadata.constants.chain"
              },
              "selector": {
                "map": "$.metadata.maps.selectors",
                "keyPath": "$.metadata.constants.chain"
              },
              "amount": {
                "map": "$.metadata.maps.amounts",
                "keyPath": "$.metadata.constants.chain"
              },
              "spender": {
                "map": "$.metadata.maps.addresses",
                "keyPath": "$.metadata.constants.chain"
              }
            }
          }
        ]
      },
      "transferNft(uint256 tokenId)": {
        "intent": "Transfer NFT",
        "fields": [
          {
            "path": "tokenId",
            "label": "NFT",
            "format": "nftName",
            "params": {
              "collection": {
                "map": "$.metadata.maps.addresses",
                "keyPath": "$.metadata.constants.chain"
              }
            }
          }
        ]
      },
      "transfer(address to, uint256 amount, address token)": {
        "intent": "Transfer",
        "fields": [
          {
            "path": "to",
            "label": "To",
            "format": "addressName",
            "params": {
              "types": [
                "eoa"
              ],
              "senderAddress": {
                "map": "$.metadata.maps.addresses",
                "keyPath": "$.metadata.constants.chain"
              }
            }
          },
          {
            "path": "amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token",
              "chainId": {
                "map": "$.metadata.maps.targetChains",
                "keyPath": "$.metadata.constants.chain"
              }
            }
          },
          {
            "path": "token",
            "label": "Token",
            "format": "tokenTicker",
            "params": {
              "chainId": {
                "map": "$.metadata.maps.targetChains",
                "keyPath": "$.metadata.constants.chain"
              }
            }
          }
        ]
      }
    }
  }
}
