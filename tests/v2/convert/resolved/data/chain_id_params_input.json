{
  "$schema": "../../../../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "chain-id-params-test",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0000000000000000000000000000000000000001"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Test Owner",
    "constants": {
      "destinationChain": 10
    }
  },
  "display": {
    "formats": {
      "bridge((address token,uint256 amount,uint256 chainId,address target,bytes data) order)": {
        "intent": "Bridge",
        "fields": [
          {
            "path": "order",
            "fields": [
              {
                "path": "amount",
                "label": "Amount",
                "format": "tokenAmount",
                "params": {
                  "tokenPath": "token",
                  "chainIdPath": "chainId"
                }
              },
              {
                "path": "token",
                "label": "Token",
                "format": "tokenTicker",
                "params": {
                  "chainIdPath": "chainId"
                }
              },
              {
                "path": "data",
                "label": "Call",
                "format": "calldata",
                "params": {
                  "calleePath": "target",
                  "chainIdPath": "chainId"
                }
              }
            ]
          }
        ]
      },
      "call(address target,bytes data)": {
        "intent": "Call",
        "fields": [
          {
            "path": "data",
            "label": "Call",
            "format": "calldata",
            "params": {
              "calleePath": "target",
              "chainId": 8453
            }
          },
          {
            "path": "target",
            "label": "Target",
            "format": "tokenTicker",
            "params": {
              "chainId": "$.metadata.constants.destinationChain"
            }
          }
        ]
      }
    }
  }
}
