{
  "$schema": "../../../../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "map-references-test",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0000000000000000000000000000000000000001"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Test Owner",
    "maps": {
      "tokens": {
        "$keyType": "Chain ID",
        "values": {
          "1": "0x0000000000000000000000000000000000000002"
        }
      },
      "chains": {
        "$keyType": "uint",
        "values": {
          "1": 10
        }
      },
      "selectors": {
        "$keyType": "Chain ID",
        "values": {
          "1": "0x12345678"
        }
      },
      "amounts": {
        "$keyType": "Chain ID",
        "values": {
          "1": 1000
        }
      },
      "senders": {
        "$keyType": "Chain ID",
        "values": {
          "1": "0x0000000000000000000000000000000000000003"
        }
      }
    }
  },
  "display": {
    "formats": {
      "execute((uint256 amount,address recipient,bytes data,uint256 id) order,uint256 route,address token)": {
        "intent": "Execute",
        "fields": [
          {
            "path": "order",
            "fields": [
              {
                "path": "amount",
                "label": "Amount",
                "format": "tokenAmount",
                "params": {
                  "token": {
                    "map": "$.metadata.maps.tokens",
                    "keyPath": "@.chainId"
                  },
                  "chainId": {
                    "map": "$.metadata.maps.chains",
                    "keyPath": "#.route"
                  }
                }
              },
              {
                "path": "recipient",
                "label": "Recipient",
                "format": "addressName",
                "params": {
                  "senderAddress": {
                    "map": "$.metadata.maps.senders",
                    "keyPath": "@.chainId"
                  }
                }
              },
              {
                "path": "data",
                "label": "Call",
                "format": "calldata",
                "params": {
                  "callee": {
                    "map": "$.metadata.maps.tokens",
                    "keyPath": "@.chainId"
                  },
                  "selector": {
                    "map": "$.metadata.maps.selectors",
                    "keyPath": "@.chainId"
                  },
                  "amount": {
                    "map": "$.metadata.maps.amounts",
                    "keyPath": "@.chainId"
                  },
                  "spender": {
                    "map": "$.metadata.maps.senders",
                    "keyPath": "@.chainId"
                  },
                  "chainId": {
                    "map": "$.metadata.maps.chains",
                    "keyPath": "id"
                  }
                }
              },
              {
                "path": "id",
                "label": "NFT",
                "format": "nftName",
                "params": {
                  "collection": {
                    "map": "$.metadata.maps.tokens",
                    "keyPath": "@.chainId"
                  }
                }
              }
            ]
          },
          {
            "path": "token",
            "label": "Token",
            "format": "tokenTicker",
            "params": {
              "chainId": {
                "map": "$.metadata.maps.chains",
                "keyPath": "route"
              }
            }
          },
          {
            "path": "route",
            "label": "Route"
          }
        ]
      }
    }
  }
}
