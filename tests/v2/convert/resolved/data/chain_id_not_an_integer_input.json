{
  "$schema": "../../../../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "chain-id-not-an-integer-test",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0000000000000000000000000000000000000001"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Test Owner",
    "constants": {
      "chain": "mainnet"
    }
  },
  "display": {
    "formats": {
      "transfer(address token,uint256 amount)": {
        "intent": "Transfer",
        "fields": [
          {
            "path": "amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token",
              "chainId": "$.metadata.constants.chain"
            }
          }
        ]
      }
    }
  }
}
